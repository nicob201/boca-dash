# Supabase → Connect → Transaction pooler (port 6543). Used by the app.
DATABASE_URL=
# Supabase → Connect → Session pooler (port 5432). Local only, for migrations.
DIRECT_URL=
# Telegram @BotFather → /newbot gives you this token.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Any long random string; cron-job.org sends it to /api/cron/tick.
CRON_SECRET=
# Your own Telegram chat id (message @userinfobot); receives admin alerts.
ADMIN_CHAT_ID=
